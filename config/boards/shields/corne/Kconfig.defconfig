if SHIELD_CORNE_DONGLE

config ZMK_KEYBOARD_NAME
    default "CORNE"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 2 halves + 5 host profiles
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif

if SHIELD_CORNE_LEFT || SHIELD_CORNE_RIGHT

config ZMK_SPLIT
	default y

config ZMK_BLE
    default y

# Upstream Corne defaults SSD1306 on even without an OLED devicetree node.
# Expose a prompt here so nice!view's CONFIG_SSD1306=n is actually respected.
config SSD1306
    bool "SSD1306 OLED on custom Corne"

endif
